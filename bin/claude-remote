#!/usr/bin/env bash
# claude-remote — spawn / list / message / close Claude Code Remote Control sessions.
#
# One CLI, several session BACKENDS underneath (lib/backend-<name>.sh):
#   tmux   — detached tmux sessions named cc—<title>          (the original backend)
#   herdr  — herdr workspaces + `herdr agent start/prompt`      (https://herdr.dev)
# Pick one with `backend = …` in the config file, CLAUDE_REMOTE_BACKEND, or --backend.
# `auto` (default) = herdr when its server is running (or we're inside a herdr pane), else tmux.
#
# Settings: ~/.config/claude-remote/config.toml — see `claude-remote config show` / `config init`.

set -euo pipefail

EM=$'—'  # em-dash separator: cc—foo
URL_TIMEOUT_S=45
POLL_INTERVAL_S=0.5

# Resolve this script's repo root (portable, follows symlinks) to find VERSION and lib/.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _d=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
    [[ "$_src" != /* ]] && _src="$_d/$_src"
done
SCRIPT_ROOT=$(cd -P "$(dirname "$_src")/.." && pwd)

die() { echo "claude-remote: $*" >&2; exit 1; }

cmd_version() {
    local v="unknown"
    [[ -f "$SCRIPT_ROOT/VERSION" ]] && v=$(cat "$SCRIPT_ROOT/VERSION")
    echo "claude-remote $v"
}

# ---------------------------------------------------------------------------
# config — built-in default < config file < CLAUDE_REMOTE_<KEY> env < command-line flag
# ---------------------------------------------------------------------------
CONFIG_FILE="${CLAUDE_REMOTE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-remote/config.toml}"
CONFIG_KEYS=(backend rc_prefix permission_mode model effort claude_bin herdr_bin message_header)

load_config() {
    command -v python3 >/dev/null || die "python3 not found"
    eval "$(python3 "$SCRIPT_ROOT/lib/config.py" load "$CONFIG_FILE")"
}

cmd_config() {
    case "${1:-show}" in
        show)
            echo "# config file: $CONFIG_FILE $([[ -f "$CONFIG_FILE" ]] && echo '(present)' || echo '(absent — built-in defaults)')"
            local k v s
            for k in "${CONFIG_KEYS[@]}"; do
                v="CFG_$k"; s="SRC_$k"
                printf '%-16s = %-40s # %s\n' "$k" "\"${!v}\"" "${!s}"
            done
            echo "# effective backend: $(pick_backend)"
            ;;
        path) echo "$CONFIG_FILE" ;;
        init)
            local force=0; [[ "${2:-}" == "--force" ]] && force=1
            if [[ -f "$CONFIG_FILE" ]] && (( !force )); then
                die "config exists: $CONFIG_FILE (use 'config init --force' to overwrite)"
            fi
            mkdir -p "$(dirname "$CONFIG_FILE")"
            cp "$SCRIPT_ROOT/config.example.toml" "$CONFIG_FILE"
            echo "wrote $CONFIG_FILE — edit it, then check with: claude-remote config show"
            ;;
        edit) "${EDITOR:-vi}" "$CONFIG_FILE" ;;
        *) die "config: usage: claude-remote config [show|path|init [--force]|edit]" ;;
    esac
}

# ---------------------------------------------------------------------------
# shared helpers (used by every backend)
# ---------------------------------------------------------------------------

# Resolve the claude binary to an ABSOLUTE path (config claude_bin wins). On some setups the
# npm-global bin dir is NOT on a non-interactive PATH, so a bare `command -v claude` fails even
# though claude is installed.
resolve_claude() {
    local c
    if [[ -n "$CFG_claude_bin" ]]; then
        c="${CFG_claude_bin/#\~/$HOME}"
        [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
        return 1
    fi
    c=$(command -v claude 2>/dev/null) && { printf '%s\n' "$c"; return 0; }
    for c in "$HOME/.npm-global/bin/claude" "$HOME/.local/bin/claude" \
             "$HOME/.claude/local/claude" /usr/local/bin/claude; do
        [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

resolve_herdr() {
    local c
    if [[ -n "$CFG_herdr_bin" ]]; then
        c="${CFG_herdr_bin/#\~/$HOME}"; [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
        return 1
    fi
    c=$(command -v herdr 2>/dev/null) && { printf '%s\n' "$c"; return 0; }
    for c in "$HOME/.local/bin/herdr" /usr/local/bin/herdr /opt/homebrew/bin/herdr; do
        [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

# Is a backend usable on this machine right now?
backend_available() {
    case "$1" in
        tmux)  command -v tmux >/dev/null ;;
        herdr) local h; h=$(resolve_herdr) || return 1
               [[ "${HERDR_ENV:-}" == 1 ]] && return 0
               "$h" status server 2>/dev/null | grep -q 'status: running' ;;
        *)     return 1 ;;
    esac
}

pick_backend() {
    local b="${OPT_backend:-$CFG_backend}"
    case "$b" in
        auto|"")
            if backend_available herdr; then echo herdr
            elif backend_available tmux; then echo tmux
            else echo none; fi ;;
        tmux|herdr) echo "$b" ;;
        *) die "unknown backend '$b' (supported: auto, tmux, herdr)" ;;
    esac
}

# Backends to SEARCH when resolving an existing session: the forced one, or (auto) every available.
search_backends() {
    local b="${OPT_backend:-$CFG_backend}"
    if [[ "$b" == auto || -z "$b" ]]; then
        backend_available herdr && echo herdr
        backend_available tmux && echo tmux
    else
        echo "$b"
    fi
    return 0
}

# Which backend hosts THIS process (for self-close / sender identity)?
current_backend() {
    if [[ "${HERDR_ENV:-}" == 1 && -n "${HERDR_PANE_ID:-}" ]]; then echo herdr
    elif [[ -n "${TMUX:-}" ]]; then echo tmux
    else echo none; fi
}

# Chat title for a new session. Explicit name wins verbatim if it already has a "device/" part;
# otherwise rc_prefix (e.g. "dev-serv-in/") is prepended to the name or folder basename.
make_title() {
    local name="$1" base="$2"
    [[ -z "$name" ]] && name="$base"
    if [[ "$name" == */* || -z "$CFG_rc_prefix" ]]; then printf '%s\n' "$name"
    else printf '%s%s\n' "$CFG_rc_prefix" "$name"; fi
}

# Claude launch flags from the effective settings → global array CLAUDE_ARGS.
build_claude_args() {
    local title="$1" pm="${OPT_permission_mode:-$CFG_permission_mode}"
    local model="${OPT_model:-$CFG_model}" effort="${OPT_effort:-$CFG_effort}"
    CLAUDE_ARGS=()
    case "$pm" in
        bypass|bypassPermissions|dangerously-skip-permissions) CLAUDE_ARGS+=(--dangerously-skip-permissions) ;;
        ""|none) ;;
        *) CLAUDE_ARGS+=(--permission-mode "$pm") ;;
    esac
    # Name Remote Control AT LAUNCH (newer claude auto-attaches RC with a derived name; a
    # post-launch /remote-control slash only opens the management dialog and ignores the name).
    CLAUDE_ARGS+=(--remote-control "$title")
    [[ -n "$OPT_resume" ]] && CLAUDE_ARGS+=(--resume "$OPT_resume")
    [[ -n "$model" ]] && CLAUDE_ARGS+=(--model "$model")
    [[ -n "$effort" ]] && CLAUDE_ARGS+=(--effort "$effort")
    return 0
}

# Pre-accept bypass mode + pre-trust the folder so claude doesn't stop on a first-run dialog.
pretrust() {
    local abs_path="$1"
    [[ -f "$HOME/.claude.json" ]] || die "~/.claude.json not found — run 'claude' once to initialize"
    python3 - "$abs_path" <<'PYEOF'
import json, os, sys, tempfile
path = sys.argv[1]
# 1) bypass-permissions confirmation (harmless when another mode is used)
sp = os.path.expanduser('~/.claude/settings.json')
os.makedirs(os.path.dirname(sp), exist_ok=True)
data = {}
if os.path.exists(sp):
    try: data = json.load(open(sp))
    except Exception: data = None
if data is not None and data.get('bypassPermissionsModeAccepted') is not True:
    data['bypassPermissionsModeAccepted'] = True
    json.dump(data, open(sp, 'w'), indent=2)
# 2) trust the folder in ~/.claude.json (atomic)
cp = os.path.expanduser('~/.claude.json')
cfg = json.load(open(cp))
entry = cfg.setdefault('projects', {}).setdefault(path, {})
if entry.get('hasTrustDialogAccepted') is not True:
    entry['hasTrustDialogAccepted'] = True
    for k, v in {'allowedTools': [], 'mcpContextUris': [], 'mcpServers': {},
                 'enabledMcpjsonServers': [], 'disabledMcpjsonServers': [],
                 'projectOnboardingSeenCount': 0, 'hasClaudeMdExternalIncludesApproved': False,
                 'hasClaudeMdExternalIncludesWarningShown': False, 'exampleFiles': []}.items():
        entry.setdefault(k, v)
    fd, tmp = tempfile.mkstemp(prefix='.claude.json.', dir=os.path.dirname(cp))
    with os.fdopen(fd, 'w') as f: json.dump(cfg, f, indent=2)
    os.replace(tmp, cp)
PYEOF
}

# _kill_claude_pids <pid…> — SIGTERM, escalate to SIGKILL if any linger. Closing a tmux session does
# NOT stop claude (it ignores SIGHUP and orphans, pinning RAM/swap), so every close finishes it off.
_kill_claude_pids() {
    local pid i alive
    for pid in "$@"; do
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null
    done
    for i in 1 2 3 4 5 6; do
        alive=0
        for pid in "$@"; do kill -0 "$pid" 2>/dev/null && alive=1; done
        (( alive )) || return 0
        sleep 0.4
    done
    for pid in "$@"; do kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null; done
    return 0
}

# Sender header for session-to-session messages, from the message_header template ({from}).
make_header() {
    local from="$1" t="$CFG_message_header"
    printf '%s' "${t//\{from\}/$from}"
}

URL_RE='https://claude\.ai/code[/?][A-Za-z0-9._~:/?#@!$&+=%-]+'

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage:
  claude-remote spawn PATH [name] [flags]     Spawn a NEW Claude Code session (Remote Control chat) in PATH
  claude-remote ls                            List running sessions (every available backend)
  claude-remote send [--raw] <session> <text…>  Message an EXISTING session (adds a "from … — to reply" header)
  claude-remote kill <session> | --all        Close a session (and make sure its claude process is gone)
  claude-remote self-close                    From INSIDE a session: deregister from claude-keep, close itself
  claude-remote refresh <session>             Re-issue /remote-control for a fresh URL
  claude-remote heal [--dry-run]              herdr: relaunch sessions that herdr auto-resumed WITHOUT our
                                              flags (after a herdr restart: RC name / permission mode / model lost)
  claude-remote config [show|path|init|edit]  Show or create the settings file
  claude-remote version | help

Spawn flags:
  --prompt, -p TEXT       Seed the new chat with a first message
  --prompt-file FILE      Same, read from FILE (multi-line, any quotes — no shell quoting issues)
  --resume, -r UUID       Resume an existing conversation instead of starting fresh
  --model, -m M           Model alias/id            (default: config 'model' → claude's own)
  --effort, -e E          low|medium|high|xhigh|max (default: config 'effort')
  --permission-mode PM    bypass|auto|acceptEdits|default|plan (default: config 'permission_mode')
  --url, -u               Also print the claude.ai/code URL
Global flag (any command):
  --backend B             tmux|herdr|auto — override the config for this call

[name] = chat title. Default: rc_prefix + folder name. A name containing "/" is used verbatim.
<session> = the chat title, its tail after "device/", or a backend id (tmux name / herdr agent / pane).

Settings file: $CONFIG_FILE  (claude-remote config show)
EOF
}

# ---------------------------------------------------------------------------
# spawn (shared arg parsing → backend)
# ---------------------------------------------------------------------------
OPT_resume="" OPT_model="" OPT_effort="" OPT_permission_mode="" OPT_backend=""
cmd_spawn() {
    local show_url=0 start_prompt="" f
    local -a pos=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --url|-u)   show_url=1 ;;
            --prompt|-p)      [[ -n "${2:-}" ]] || die "--prompt requires text"; start_prompt="$2"; shift ;;
            --prompt-file)    f="${2:-}"; [[ -f "$f" ]] || die "--prompt-file: no such file: $f"
                              start_prompt=$(cat "$f"); shift ;;
            --resume|-r)      [[ -n "${2:-}" ]] || die "--resume requires a session UUID"; OPT_resume="$2"; shift ;;
            --model|-m)       [[ -n "${2:-}" ]] || die "--model requires a model alias or id"; OPT_model="$2"; shift ;;
            --effort|-e)      [[ -n "${2:-}" ]] || die "--effort requires a level"; OPT_effort="$2"; shift ;;
            --permission-mode) [[ -n "${2:-}" ]] || die "--permission-mode requires a mode"; OPT_permission_mode="$2"; shift ;;
            --)         shift; while [[ $# -gt 0 ]]; do pos+=("$1"); shift; done; break ;;
            -*)         die "spawn: unknown flag '$1' (see claude-remote help)" ;;
            *)          pos+=("$1") ;;
        esac
        shift
    done

    local raw_path="${pos[0]:-}" name="${pos[1]:-}"
    [[ -z "$raw_path" ]] && { usage; exit 2; }

    local abs_path
    abs_path=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$raw_path")
    [[ -d "$abs_path" ]] || mkdir -p "$abs_path"

    local title; title=$(make_title "$name" "$(basename "$abs_path")")
    local backend; backend=$(pick_backend)
    [[ "$backend" == none ]] && die "no session backend available (install tmux or herdr)"
    pretrust "$abs_path"
    "${backend}_spawn" "$abs_path" "$title" "$show_url" "$start_prompt"
}

# ---------------------------------------------------------------------------
# resolve an existing session across backends → sets R_BACKEND + R_ID
# ---------------------------------------------------------------------------
resolve_any() {
    local q="$1" b out rc found=0 errs=""
    R_BACKEND="" R_ID=""
    while IFS= read -r b; do
        [[ -n "$b" ]] || continue
        if out=$("${b}_resolve" "$q" 2>&1); then
            R_BACKEND="$b"; R_ID="$out"; found=1; break
        else
            rc=$?
            (( rc == 2 )) && { echo "$out" >&2; return 2; }   # ambiguous — never guess
            errs+="$b: $out"$'\n'
        fi
    done < <(search_backends)
    (( found )) && return 0
    printf 'no such session: %s\n%s' "$q" "$errs" >&2
    return 1
}

cmd_ls() {
    local b any=0
    while IFS= read -r b; do
        [[ -n "$b" ]] || continue
        any=1
        echo "## $b"
        "${b}_ls"
    done < <(search_backends)
    (( any )) || echo "(no session backend available — install tmux or herdr)"
}

cmd_send() {
    local raw=0
    [[ "${1:-}" == "--raw" ]] && { raw=1; shift; }
    local q="${1:-}"; shift || true
    local text="$*"
    [[ -n "$q" ]] || die "send: usage: claude-remote send [--raw] <session> <text…>"
    [[ -n "$text" ]] || die "send: nothing to send (give the message after the session name)"
    resolve_any "$q" || exit 1
    local from="" cb; cb=$(current_backend)
    if (( !raw )) && [[ "$cb" != none ]]; then
        from=$("${cb}_whoami" 2>/dev/null || true)
        [[ -n "$from" ]] && text="$(make_header "$from") ${text}"
    fi
    "${R_BACKEND}_send" "$R_ID" "$text" "$from"
}

cmd_kill() {
    case "${1:-}" in
        "") echo "claude-remote kill: missing <session> or --all" >&2; exit 2 ;;
        --all)
            local b
            while IFS= read -r b; do [[ -n "$b" ]] && "${b}_kill_all"; done < <(search_backends) ;;
        *)
            resolve_any "$1" || exit 1
            "${R_BACKEND}_kill" "$R_ID" ;;
    esac
}

cmd_refresh() {
    [[ -n "${1:-}" ]] || { echo "usage: claude-remote refresh <session>" >&2; exit 2; }
    resolve_any "$1" || exit 1
    "${R_BACKEND}_refresh" "$R_ID"
}

cmd_self_close() {
    local cb; cb=$(current_backend)
    [[ "$cb" == none ]] && die "self-close: not inside a tmux or herdr session (run it from within the session)"
    if command -v claude-keep >/dev/null 2>&1; then
        claude-keep rm >/dev/null 2>&1 && echo "deregistered from claude-keep" \
            || echo "note: not tracked by claude-keep (nothing to deregister)"
    fi
    "${cb}_self_close"
}

cmd_heal() {
    backend_available herdr || die "heal: herdr is not running here (heal is herdr-only; tmux sessions are healed by claude-keep)"
    herdr_heal "$@"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
# --backend may appear anywhere; strip it before dispatch.
_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --backend) [[ -n "${2:-}" ]] || die "--backend requires tmux|herdr|auto"; OPT_backend="$2"; shift 2 ;;
        --backend=*) OPT_backend="${1#--backend=}"; shift ;;
        *) _args+=("$1"); shift ;;
    esac
done
set -- "${_args[@]+"${_args[@]}"}"

load_config
# shellcheck source=../lib/backend-tmux.sh
source "$SCRIPT_ROOT/lib/backend-tmux.sh"
# shellcheck source=../lib/backend-herdr.sh
source "$SCRIPT_ROOT/lib/backend-herdr.sh"

case "${1:-}" in
    -h|--help|help) usage ;;
    -V|--version|version) cmd_version ;;
    "")         usage; exit 2 ;;
    ls|list)    cmd_ls ;;
    kill)       shift; cmd_kill "$@" ;;
    spawn)      shift; cmd_spawn "$@" ;;
    refresh)    shift; cmd_refresh "$@" ;;
    send)       shift; cmd_send "$@" ;;
    self-close) cmd_self_close ;;
    heal)       shift; cmd_heal "$@" ;;
    config)     shift; cmd_config "$@" ;;
    # Spawning is EXPLICIT — an unknown command errors, it can never spawn a junk session.
    *)          die "unknown command '$1'. To spawn a session: claude-remote spawn <path> [name].
   Subcommands: spawn · ls · send · kill · refresh · self-close · heal · config · version · help" ;;
esac
