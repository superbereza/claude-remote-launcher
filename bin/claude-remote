#!/usr/bin/env bash
# claude-remote — spawn / list / kill Claude Code remote-control sessions.
#
# Subcommands:
#   claude-remote <path> [name] [--url]    (implicit spawn)
#   claude-remote spawn <path> [name] [--url]   (explicit)
#   claude-remote ls
#   claude-remote kill <session>
#   claude-remote kill --all

set -euo pipefail

EM=$'—'  # em-dash separator: cc—foo—task
URL_TIMEOUT_S=45
POLL_INTERVAL_S=0.5

# Resolve this script's repo root (portable, follows symlinks) to find VERSION.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _d=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
    [[ "$_src" != /* ]] && _src="$_d/$_src"
done
SCRIPT_ROOT=$(cd -P "$(dirname "$_src")/.." && pwd)

cmd_version() {
    local v="unknown"
    [[ -f "$SCRIPT_ROOT/VERSION" ]] && v=$(cat "$SCRIPT_ROOT/VERSION")
    echo "claude-remote $v"
}

# Resolve the claude binary to an ABSOLUTE path. Prefer PATH, but fall back to known
# install locations: on some setups (e.g. a server where claude lives in ~/.npm-global)
# the npm-global bin dir is NOT on a non-interactive PATH, so a bare `command -v claude`
# fails even though claude is installed and runnable. Using the resolved absolute path
# for the in-tmux launch too makes the spawn independent of the pane's PATH.
resolve_claude() {
    local c
    c=$(command -v claude 2>/dev/null) && { printf '%s\n' "$c"; return 0; }
    for c in "$HOME/.npm-global/bin/claude" "$HOME/.local/bin/claude" \
             "$HOME/.claude/local/claude" /usr/local/bin/claude; do
        [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

usage() {
    cat <<EOF
Usage:
  claude-remote <path> [name] [--url] [--prompt <text>] [--resume <uuid>] [--model <m>] [--effort <e>]
                                              Spawn a session (default action)
  claude-remote spawn <path> [name] [--url] [--prompt <text>] [--resume <uuid>] [--model <m>] [--effort <e>]
                                              Same as above, explicit
  claude-remote ls                            List running cc— tmux sessions
  claude-remote send [--raw] <session> <text…>  Send a message into an EXISTING session and submit it.
                                              Prefixes a "from <this session> — reply: …" header so the
                                              receiver knows who asked and how to answer back; --raw omits it.
  claude-remote kill <session>                Kill one tmux session
  claude-remote kill --all                    Kill all cc— tmux sessions
  claude-remote self-close                    From INSIDE a session: deregister from claude-keep (if
                                              tracked), then kill this session's tmux
  claude-remote refresh <session>             Re-issue /remote-control for a fresh URL
  claude-remote help                          Show this help

Args:
  <path>   Project folder (created if it doesn't exist).
  [name]   Session name = remote-control chat title. Default: the folder name.
           Pass it in full (e.g. "mac-mini/ai-auth-lib") for a "device/" prefix —
           nothing is prepended automatically.

Flags:
  --url, -u           Also print the claude.ai/code URL. Default: status only.
  --prompt <text>     Seed the new chat: once it's up, type <text> into the pane and
  -p <text>           submit it — the fresh session starts working on it immediately.
  --resume <uuid>     Resume an existing session by UUID in the new tmux pane
  -r <uuid>           (instead of starting a fresh conversation).
  --model <m>         Launch on a specific model (alias: opus/sonnet/fable, or a
  -m <m>              full id like claude-opus-4-8). Default: claude's own default.
  --effort <e>        Launch with an effort level: low|medium|high|xhigh|max.
  -e <e>              Default: claude's own default.

Spawn output (default):
  SESSION: <tmux name>
  STATUS:  remote-control active
  ATTACH:  tmux attach -t <session>

With --url the STATUS line becomes:
  URL:     https://claude.ai/code/...

Exit 1 only if Remote Control doesn't activate within ${URL_TIMEOUT_S}s
  (a missing --url link while RC is active is NOT a failure).
EOF
}

die() { echo "claude-remote: $*" >&2; exit 1; }

# _bridge_up <tmux_name> <abs_cwd> — is Remote Control REGISTERED for this session?
# Authoritative signal alongside the TUI scrape: Claude writes ~/.claude/sessions/<pid>.json per
# running process, and it gains a `bridgeSessionId` once Remote Control is up (absence = not yet;
# presence = up — decisive for confirming STARTUP). Two matchers, in order:
#   1. via the SESSION — the state file whose cwd is this launch dir (real-path matched, unique).
#   2. fallback via the PANEL — match by the tmux pane's process tree (disambiguates a shared cwd,
#      or a cwd that didn't resolve-match).
# Returns 0 iff a matching state file has a bridgeSessionId. Best-effort: returns 1 (not 0) if
# python3 / the state file are absent, so the caller still relies on the pane-scrape signal.
_bridge_up() {
    local tmux_name="$1" abs_cwd="$2"
    command -v python3 >/dev/null || return 1
    python3 - "$tmux_name" "$abs_cwd" <<'PY'
import glob, json, os, subprocess, sys
tmux_name, want = sys.argv[1], sys.argv[2]
rp = os.path.realpath(want)
states = []
for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
    try: states.append(json.load(open(f)))
    except Exception: pass

# 1) via the session: unique state file whose cwd is this launch dir
by_cwd = [d for d in states if d.get("cwd") and os.path.realpath(d["cwd"]) == rp]
if len(by_cwd) == 1:
    sys.exit(0 if by_cwd[0].get("bridgeSessionId") else 1)

# 2) fallback via the panel: the tmux pane's process tree
try:
    pane_pid = int(subprocess.run(
        ["tmux", "list-panes", "-t", tmux_name, "-F", "#{pane_pid}"],
        capture_output=True, text=True).stdout.split()[0])
except Exception:
    pane_pid = 0
if pane_pid:
    children = {}
    for s in glob.glob("/proc/[0-9]*/stat"):
        try:
            txt = open(s).read()
            pid = int(os.path.basename(os.path.dirname(s)))
            ppid = int(txt.rsplit(") ", 1)[1].split()[1])
        except Exception:
            continue
        children.setdefault(ppid, []).append(pid)
    tree, stack = set(), [pane_pid]
    while stack:
        p = stack.pop()
        if p in tree: continue
        tree.add(p); stack += children.get(p, [])
    for d in states:
        if d.get("pid") in tree:
            sys.exit(0 if d.get("bridgeSessionId") else 1)
sys.exit(1)
PY
}

# ---------------------------------------------------------------------------
# spawn
# ---------------------------------------------------------------------------
cmd_spawn() {
    # Flags may appear anywhere among the args. Default: status only, no URL.
    # Pass --url (-u) to also print the claude.ai/code URL.
    # Pass --resume <uuid> to resume an existing session by its UUID instead
    # of starting a new conversation in the pane.
    # Pass --model <alias> to launch on a specific model (alias like opus/sonnet/
    # fable, or a full id like claude-opus-4-8). Default: claude's own default.
    local show_url=0
    local resume_uuid=""
    local model=""
    local effort=""
    local start_prompt=""
    local -a pos=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --url|-u)   show_url=1 ;;
            --prompt|-p)
                [[ -n "${2:-}" ]] || die "--prompt requires text"
                start_prompt="$2"
                shift
                ;;
            --resume|-r)
                [[ -n "${2:-}" ]] || die "--resume requires a session UUID"
                resume_uuid="$2"
                shift
                ;;
            --model|-m)
                [[ -n "${2:-}" ]] || die "--model requires a model alias or id"
                model="$2"
                shift
                ;;
            --effort|-e)
                [[ -n "${2:-}" ]] || die "--effort requires a level (low|medium|high|xhigh|max)"
                effort="$2"
                shift
                ;;
            --)         shift; while [[ $# -gt 0 ]]; do pos+=("$1"); shift; done; break ;;
            *)          pos+=("$1") ;;
        esac
        shift
    done

    local raw_path="${pos[0]:-}"
    local name="${pos[1]:-}"
    [[ -z "$raw_path" ]] && { usage; exit 2; }

    command -v tmux    >/dev/null || die "tmux not found"
    local CLAUDE_BIN
    CLAUDE_BIN=$(resolve_claude) || die "claude not found (checked PATH, ~/.npm-global/bin, ~/.local/bin, ~/.claude/local)"
    command -v python3 >/dev/null || die "python3 not found"
    [[ -f "$HOME/.claude.json" ]] || die "~/.claude.json not found — run 'claude' once to initialize"

    local abs_path
    abs_path=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$raw_path")

    local is_new=0
    [[ -d "$abs_path" ]] || is_new=1
    (( is_new )) && mkdir -p "$abs_path"

    local base session_name tmux_name final_name
    base=$(basename "$abs_path")
    # Session name = remote-control chat title. Defaults to the folder name
    # (clean, no timestamp). Nothing is prepended automatically — pass the name
    # in full (e.g. "mac-mini/ai-auth-lib") if you want a "device/" prefix.
    [[ -z "$name" ]] && name="$base"

    # Pick a free name. The collision check must be EXACT: `tmux has-session -t X`
    # matches on an unambiguous PREFIX, so spawning "dev" when a "dev-helper"
    # session exists would falsely "collide" and bump to "dev-2". Compare full
    # session names with `grep -xF` instead (handles the em-dash and slashes).
    # On a REAL collision, number BOTH the tmux session AND the chat title, so the
    # two chats are distinguishable on the device (not two identically-named ones).
    final_name="$name"
    local i=2
    while tmux list-sessions -F '#{session_name}' 2>/dev/null \
            | grep -qxF -- "cc${EM}${final_name}"; do
        final_name="${name}-${i}"
        ((i++))
    done
    session_name="cc${EM}${final_name}"
    tmux_name="$session_name"

    # Pre-accept bypass-permissions mode so claude won't pause on the
    # one-time confirmation dialog on its first --dangerously-skip-permissions run.
    # Idempotent: only writes the flag, preserves any other settings.
    python3 - <<'PYEOF'
import json, os
path = os.path.expanduser('~/.claude/settings.json')
os.makedirs(os.path.dirname(path), exist_ok=True)
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {}
if data.get('bypassPermissionsModeAccepted') is not True:
    data['bypassPermissionsModeAccepted'] = True
    with open(path, 'w') as f:
        json.dump(data, f, indent=2)
PYEOF

    # Pre-trust path in ~/.claude.json (atomic)
    python3 - "$abs_path" <<'PYEOF'
import json, os, sys, tempfile
path = sys.argv[1]
cfg_path = os.path.expanduser('~/.claude.json')
with open(cfg_path) as f:
    cfg = json.load(f)
projs = cfg.setdefault('projects', {})
entry = projs.setdefault(path, {})
entry['hasTrustDialogAccepted'] = True
defaults = {
    'allowedTools': [],
    'mcpContextUris': [],
    'mcpServers': {},
    'enabledMcpjsonServers': [],
    'disabledMcpjsonServers': [],
    'projectOnboardingSeenCount': 0,
    'hasClaudeMdExternalIncludesApproved': False,
    'hasClaudeMdExternalIncludesWarningShown': False,
    'exampleFiles': [],
}
for k, v in defaults.items():
    entry.setdefault(k, v)
fd, tmp = tempfile.mkstemp(prefix='.claude.json.', dir=os.path.dirname(cfg_path))
with os.fdopen(fd, 'w') as f:
    json.dump(cfg, f, indent=2)
os.replace(tmp, cfg_path)
PYEOF

    tmux new-session -d -s "$tmux_name" -c "$abs_path"

    # Chat title follows the (possibly numbered) final name, so a collision-bumped
    # session shows as "name-2" on the device instead of a duplicate "name".
    local claude_name="$final_name"

    # Build the claude launch command. With --resume <uuid>, claude reopens that
    # specific session in this pane instead of starting a fresh conversation.
    local claude_cmd="$CLAUDE_BIN --dangerously-skip-permissions"
    if [[ -n "$resume_uuid" ]]; then
        claude_cmd+=" --resume $resume_uuid"
    fi
    if [[ -n "$model" ]]; then
        claude_cmd+=" --model $model"
    fi
    if [[ -n "$effort" ]]; then
        claude_cmd+=" --effort $effort"
    fi

    # Start interactive Claude; we'll enable Remote Control via slash.
    tmux send-keys -t "$tmux_name" "$claude_cmd" Enter

    # Wait for the TUI to reach ready state (bottom bar shows "bypass permissions on").
    # Trust dialog is skipped because we pre-wrote hasTrustDialogAccepted above.
    local ready=0
    local ready_iters
    ready_iters=$(awk 'BEGIN{print int(40/0.5)}')
    for _ in $(seq 1 "$ready_iters"); do
        local pane
        pane=$(tmux capture-pane -p -J -t "$tmux_name" -S -200 2>/dev/null || true)
        if printf '%s' "$pane" | grep -q 'bypass permissions on'; then
            ready=1
            break
        fi
        sleep 0.5
    done

    if (( !ready )); then
        echo "claude-remote: claude TUI didn't reach ready state in 40s — check 'tmux attach -t $tmux_name'" >&2
        exit 1
    fi

    # Enable Remote Control via slash (carries chat history; cleanly recoverable).
    # No quotes around the name — slash command takes the rest of the line as the title verbatim,
    # so quotes would end up in the displayed name.
    tmux send-keys -t "$tmux_name" "/remote-control ${claude_name}" Enter

    local url="" rc_active=0 confirmed_rc=0 iters
    iters=$(awk -v t="$URL_TIMEOUT_S" -v s="$POLL_INTERVAL_S" 'BEGIN{print int(t/s)}')
    for _ in $(seq 1 "$iters"); do
        local pane
        pane=$(tmux capture-pane -p -J -t "$tmux_name" -S -200 2>/dev/null || true)
        # Auto-confirm the "Enable Remote Control" prompt (default option 1)
        # that appears the first time /remote-control runs in a session.
        if (( !confirmed_rc )) && printf '%s' "$pane" | grep -q 'Enable Remote Control'; then
            tmux send-keys -t "$tmux_name" Enter
            confirmed_rc=1
            sleep 0.5
            continue
        fi
        # Primary success signal is the persistent "Remote Control active" status
        # bar — NOT the URL. The URL is only needed for --url, and it can appear
        # late or scroll out of the captured window, which used to cause a false
        # "not detected" + exit 1 even though RC was up.
        printf '%s' "$pane" | grep -q 'Remote Control active' && rc_active=1
        # Corroborating AUTHORITATIVE signal — Remote Control registered in the state file
        # (bridgeSessionId). OR'd with the TUI scrape above: whichever confirms first wins, so a
        # lagging/reworded status bar no longer false-fails a session that's actually up. Only
        # probed until confirmed, to avoid the per-iteration cost once rc_active is set.
        (( rc_active )) || { _bridge_up "$tmux_name" "$abs_path" && rc_active=1; }
        if [[ -z "$url" ]]; then
            url=$(printf '%s' "$pane" | grep -oE 'https://claude\.ai/code[/?][A-Za-z0-9._~:/?#@!$&+=%-]+' | tail -1 || true)
        fi
        # Done once RC is active (and, if --url was asked, once we also have the URL).
        if (( rc_active )) && { (( !show_url )) || [[ -n "$url" ]]; }; then break; fi
        sleep "$POLL_INTERVAL_S"
    done

    # --prompt: seed the fresh chat — type the starting prompt into the pane and submit it.
    # Sent literally (-l; -- guards a leading dash) once Remote Control is confirmed up, so it
    # lands in the now-clear composer. tmux needs a beat between the text and the Enter.
    local prompt_sent=0
    if [[ -n "$start_prompt" ]] && (( rc_active )); then
        tmux send-keys -t "$tmux_name" -l -- "$start_prompt"
        sleep 0.4
        tmux send-keys -t "$tmux_name" Enter
        prompt_sent=1
    fi

    printf 'SESSION: %s\n' "$tmux_name"
    if (( show_url )); then
        if [[ -n "$url" ]]; then
            printf 'URL:     %s\n' "$url"
        elif (( rc_active )); then
            printf 'URL:     <RC active; link not captured — run: claude-remote refresh %q>\n' "$tmux_name"
        else
            printf 'URL:     <remote-control did not come up within %ss — check pane>\n' "$URL_TIMEOUT_S"
        fi
    else
        if (( rc_active )); then
            printf 'STATUS:  remote-control active\n'
        else
            printf 'STATUS:  remote-control did NOT activate within %ss — check pane\n' "$URL_TIMEOUT_S"
        fi
    fi
    printf "ATTACH:  tmux attach -t '%s'\n" "$tmux_name"
    (( prompt_sent )) && printf 'PROMPT:  sent (%d chars)\n' "${#start_prompt}"

    # Fail only if Remote Control genuinely never activated (not merely "no URL").
    if (( !rc_active )); then
        echo "claude-remote: --- last 30 lines of pane '$tmux_name' ---" >&2
        tmux capture-pane -p -J -t "$tmux_name" -S -30 2>/dev/null >&2 || true
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# refresh — re-issue /remote-control inside an existing session to get a fresh URL
# ---------------------------------------------------------------------------
cmd_refresh() {
    local name="${1:-}"
    [[ -z "$name" ]] && { echo "usage: claude-remote refresh <session>" >&2; exit 2; }
    tmux has-session -t "$name" 2>/dev/null || die "no such session: $name"

    # Capture the URL currently printed (if any) so we can detect the new one.
    local old_url
    old_url=$(tmux capture-pane -p -J -t "$name" -S -300 \
              | grep -oE 'https://claude\.ai/code[/?][A-Za-z0-9._~:/?#@!$&+=%-]+' \
              | tail -1 || true)

    tmux send-keys -t "$name" '/remote-control' Enter

    local url=""
    local iters
    iters=$(awk -v t="$URL_TIMEOUT_S" -v s="$POLL_INTERVAL_S" 'BEGIN{print int(t/s)}')
    for _ in $(seq 1 "$iters"); do
        local pane
        pane=$(tmux capture-pane -p -J -t "$name" -S -300 2>/dev/null || true)
        local cand
        cand=$(printf '%s' "$pane" | grep -oE 'https://claude\.ai/code[/?][A-Za-z0-9._~:/?#@!$&+=%-]+' | tail -1 || true)
        if [[ -n "$cand" && "$cand" != "$old_url" ]]; then
            url="$cand"
            break
        fi
        sleep "$POLL_INTERVAL_S"
    done

    printf 'SESSION: %s\n' "$name"
    if [[ -n "$url" ]]; then
        printf 'URL:     %s\n' "$url"
    else
        printf 'URL:     <no new URL within %ss — old still: %s>\n' "$URL_TIMEOUT_S" "${old_url:-none}"
    fi
    [[ -n "$url" ]] || exit 1
}

# ---------------------------------------------------------------------------
# ls
# ---------------------------------------------------------------------------
cmd_list() {
    local rows
    rows=$(tmux list-sessions -F '#{session_name}|#{session_path}' 2>/dev/null | grep '^cc—' || true)
    if [[ -z "$rows" ]]; then
        echo "(no cc— sessions running)"
        return
    fi
    printf '%-50s  %s\n' "SESSION" "PATH"
    printf '%s\n' "$rows" | awk -F'|' '{ printf "%-50s  %s\n", $1, $2 }'
}

# ---------------------------------------------------------------------------
# kill <name> | kill --all
# ---------------------------------------------------------------------------
cmd_kill() {
    case "${1:-}" in
        "")
            echo "claude-remote kill: missing <name> or --all" >&2
            exit 2
            ;;
        --all)
            local names
            names=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^cc—' || true)
            if [[ -z "$names" ]]; then
                echo "(no cc— sessions to kill)"
                return
            fi
            while IFS= read -r n; do
                tmux kill-session -t "$n" && echo "killed: $n"
            done <<< "$names"
            ;;
        *)
            local name="$1"
            if tmux has-session -t "$name" 2>/dev/null; then
                tmux kill-session -t "$name"
                echo "killed: $name"
            else
                echo "no such session: $name" >&2
                exit 1
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------
# send [--raw] <session> <text…> — inject a message into an EXISTING session's pane and
# submit it. The "talk to a session that's already running" gap: spawn seeds a NEW chat
# (--prompt), this drives an existing one. Sent literally (-l; -- guards a leading dash);
# if the target is mid-generation the message simply queues (Claude handles the queue).
#
# By default the message is prefixed with a one-line header naming the SENDER session and
# how to reply — so the receiver knows whose question it is and can answer back:
#     [from cc—X — reply: claude-remote send 'cc—X' "…"] <text>
# The sender is this command's own tmux session ($TMUX). Pass --raw to send verbatim (no
# header) — e.g. when injecting a command/prompt rather than a session-to-session message.
# ---------------------------------------------------------------------------
cmd_send() {
    local raw=0 from=""
    [[ "${1:-}" == "--raw" ]] && { raw=1; shift; }
    local name="${1:-}"; shift || true
    local text="$*"
    [[ -n "$name" ]] || die "send: usage: claude-remote send [--raw] <session> <text…>"
    [[ -n "$text" ]] || die "send: nothing to send (give the message after the session name)"
    command -v tmux >/dev/null || die "tmux not found"
    # Resolve to a pane id — em-dash/slash session names don't match reliably via -t "=name".
    local pane
    pane=$(tmux list-panes -a -F "#{session_name}"$'\t'"#{pane_id}" 2>/dev/null \
             | awk -F'\t' -v s="$name" '$1==s{print $2; exit}')
    [[ -n "$pane" ]] || die "send: no such session: $name"
    # Prefix with sender + reply hint, unless --raw or we're not inside a (different) session.
    if (( ! raw )); then
        from=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
        [[ -n "$from" && "$from" != "$name" ]] && \
            text="[from ${from} — to reply: claude-remote send '${from}' \"<your answer>\"] ${text}"
    fi
    if tmux capture-pane -p -J -t "$pane" -S -3 2>/dev/null | grep -q 'esc to interrupt'; then
        echo "note: '$name' is busy — the message will queue until it's idle" >&2
    fi
    tmux send-keys -t "$pane" -l -- "$text"
    sleep 0.4
    tmux send-keys -t "$pane" Enter
    echo "sent to $name (${#text} chars${from:+, from $from})"
}

# ---------------------------------------------------------------------------
# self-close — a running session ends ITSELF: first deregister from the keeper's
# registry, then drop its own tmux session. Registry and session lifecycle live in TWO
# SEPARATE skills, so we keep them decoupled: this (a session-lifecycle op) belongs to
# claude-remote, and it DELEGATES the registry cleanup to claude-keep's own self-aware
# `rm` (only if that skill is installed — no hard dependency, no duplicated registry logic).
# Order matters: unregister BEFORE we die, so a self-heal timer doesn't relaunch us.
# ---------------------------------------------------------------------------
cmd_self_close() {
    command -v tmux >/dev/null || die "self-close: tmux not found"
    local self
    self=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    [[ -n "$self" ]] || die "self-close: not inside a tmux session (run this from within the session)"
    if command -v claude-keep >/dev/null 2>&1; then
        claude-keep rm >/dev/null 2>&1 && echo "deregistered from claude-keep: $self" \
            || echo "note: not tracked by claude-keep (nothing to deregister)"
    fi
    echo "self-close: killing tmux session '$self' …"
    tmux kill-session -t "=$self"     # ends this process; nothing runs after this
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
    -h|--help|help) usage ;;
    -V|--version) cmd_version ;;
    "")        usage; exit 2 ;;
    ls)        cmd_list ;;
    kill)      shift; cmd_kill "$@" ;;
    spawn)     shift; cmd_spawn "$@" ;;
    refresh)   shift; cmd_refresh "$@" ;;
    send)      shift; cmd_send "$@" ;;
    self-close) cmd_self_close ;;
    *)         cmd_spawn "$@" ;;
esac
